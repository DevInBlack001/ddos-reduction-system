# Example configuration for scripts/benchmark_live.sh.
#
# Copy this file, fill in your own hosts and generator commands, and pass
# the copy as benchmark_live.sh's one argument. Addresses below are from
# this project's documentation ranges (RFC 5737), not real hosts.
#
# Traffic generation is not prescribed, matching docs/training.md: the
# START_CMD / STOP_CMD variables are literal shell commands run over SSH on
# the named host. Use whatever load testing tool, scripted client, or packet
# crafting tool you already have; this script only handles phase timing,
# warm-up detection, log capture, and reporting.

# --- The gateway running FLOD ---
GATEWAY_HOST="root@192.0.2.1"
GATEWAY_SSH_KEY="$HOME/.ssh/gateway_key"
STAGE1_UNIT="ddos-stage1.service"
STAGE2_UNIT="ddos-stage2.service"
BLOCKLIST_SET="ddos_blocklist"
RATELIMIT_SET="ddos_ratelimit"

# --- Targets under test (protected hosts), comma separated ---
# Used only for documentation in the report; the actual traffic goes wherever
# your generator commands below point it.
TARGET_IPS="192.0.2.10,192.0.2.11,192.0.2.12"

# --- Generator hosts. Two are supported (matching a typical lab with an
# "attacker" box and a "flash crowd" box); leave the _2 variables empty if
# you only have one. ---
NORMAL_HOST="root@198.51.100.10"
NORMAL_SSH_KEY="$HOME/.ssh/normal_key"
NORMAL_HOST_2="root@198.51.100.11"
NORMAL_SSH_KEY_2="$HOME/.ssh/normal_key"

FLASHCROWD_HOST="root@198.51.100.10"
FLASHCROWD_SSH_KEY="$HOME/.ssh/normal_key"
FLASHCROWD_HOST_2="root@198.51.100.11"
FLASHCROWD_SSH_KEY_2="$HOME/.ssh/normal_key"

ATTACK_HOST="root@198.51.100.10"
ATTACK_SSH_KEY="$HOME/.ssh/normal_key"

# --- Phase 1: Normal. Start/stop commands, one or two generator hosts. ---
NORMAL_START_CMD="cd /root && nohup locust -f locust.py --headless -u 100 -r 10 --run-time 30m > /root/bench_normal.log 2>&1 & echo \$! > /root/bench_normal.pid"
NORMAL_STOP_CMD="kill \$(cat /root/bench_normal.pid) 2>/dev/null; pkill -9 -f '[l]ocust -f locust.py' 2>/dev/null"
NORMAL_START_CMD_2="cd /root && nohup locust -f locust.py --headless -u 100 -r 10 --run-time 30m > /root/bench_normal.log 2>&1 & echo \$! > /root/bench_normal.pid"
NORMAL_STOP_CMD_2="kill \$(cat /root/bench_normal.pid) 2>/dev/null; pkill -9 -f '[l]ocust -f locust.py' 2>/dev/null"

# --- Phase 2: Flash Crowd. ---
FLASHCROWD_START_CMD="nohup /usr/local/bin/high_traffic even /root/targets.txt /tmp/source_ips.txt 3600 > /root/bench_crowd.log 2>&1 & echo \$! > /root/bench_crowd.pid"
FLASHCROWD_STOP_CMD="kill \$(cat /root/bench_crowd.pid) 2>/dev/null; pkill -9 -f '[h]igh_traffic' 2>/dev/null"
FLASHCROWD_START_CMD_2="nohup /usr/local/bin/high_traffic even /root/targets.txt /tmp/source_ips.txt 3600 > /root/bench_crowd.log 2>&1 & echo \$! > /root/bench_crowd.pid"
FLASHCROWD_STOP_CMD_2="kill \$(cat /root/bench_crowd.pid) 2>/dev/null; pkill -9 -f '[h]igh_traffic' 2>/dev/null"

# --- Phase 3: Attacker. ---
ATTACK_START_CMD="nohup /root/attack_mp_jittered /root/targets.txt /tmp/source_ips.txt 3600 > /root/bench_attack.log 2>&1 & echo \$! > /root/bench_attack.pid"
ATTACK_STOP_CMD="kill \$(cat /root/bench_attack.pid) 2>/dev/null; pkill -9 -f '[h]ping3' 2>/dev/null; pkill -9 -f '[a]ttack_mp_jittered' 2>/dev/null"

# --- Phase 4: Mixed. Point each at a DIFFERENT subset of targets (separate
# target files/args on your generator side) to demonstrate per-target
# independent classification under simultaneous, different conditions. ---
MIXED_NORMAL_START_CMD="cd /root && nohup locust -f locust.py --headless -u 100 -r 10 --run-time 10m > /root/bench_mixed_normal.log 2>&1 & echo \$! > /root/bench_mixed_normal.pid"
MIXED_NORMAL_STOP_CMD="kill \$(cat /root/bench_mixed_normal.pid) 2>/dev/null; pkill -9 -f '[l]ocust -f locust.py' 2>/dev/null"
MIXED_NORMAL_START_CMD_2="cd /root && nohup locust -f locust.py --headless -u 100 -r 10 --run-time 10m > /root/bench_mixed_normal.log 2>&1 & echo \$! > /root/bench_mixed_normal.pid"
MIXED_NORMAL_STOP_CMD_2="kill \$(cat /root/bench_mixed_normal.pid) 2>/dev/null; pkill -9 -f '[l]ocust -f locust.py' 2>/dev/null"

MIXED_FLASHCROWD_START_CMD="nohup /usr/local/bin/high_traffic even /root/targets_mixed_crowd.txt /tmp/source_ips.txt 180 > /root/bench_mixed_crowd.log 2>&1 & echo \$! > /root/bench_mixed_crowd.pid"
MIXED_FLASHCROWD_STOP_CMD="kill \$(cat /root/bench_mixed_crowd.pid) 2>/dev/null; pkill -9 -f '[h]igh_traffic' 2>/dev/null"

MIXED_ATTACK_START_CMD="nohup /root/attack_s_mp_jittered \$(head -1 /tmp/source_ips.txt) /root/targets_mixed_attack.txt 180 > /root/bench_mixed_attack.log 2>&1 & echo \$! > /root/bench_mixed_attack.pid"
MIXED_ATTACK_STOP_CMD="kill \$(cat /root/bench_mixed_attack.pid) 2>/dev/null; pkill -9 -f '[a]ttack_s_mp_jittered' 2>/dev/null"

# --- Timing (seconds). Defaults shown; override if you need longer/shorter
# observation windows. ---
WARMUP_TIMEOUT_SECS=900
NORMAL_SECS=120
FLASHCROWD_SECS=120
ATTACK_SECS=180
MIXED_SECS=120

# --- Where logs and the report land, relative to the repo root. ---
OUTPUT_DIR="./benchmark-live-results"
