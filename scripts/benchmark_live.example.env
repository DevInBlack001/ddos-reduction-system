# Example configuration for scripts/benchmark_live.sh.
#
# Copy this file, fill in your own hosts and generator commands, and pass
# the copy as benchmark_live.sh's one argument. Addresses below are from
# this project's documentation ranges (RFC 5737), not real hosts.
#
# Traffic generation is not prescribed, matching docs/training.md: the
# START_CMD / STOP_CMD variables are literal shell commands run over SSH on
# the named host. Use whatever load testing tool, scripted client, or packet
# crafting tool you already have; this script only handles phase timing,
# warm-up detection, log capture, and reporting.
#
# One start/stop command pair per traffic type, reused across every phase
# that wants it active: benchmark_live.sh only starts or stops a generator
# when the desired state actually changes between phases, so Normal started
# for Phase 1 keeps running unchanged into Phase 4 (Normal + Flash Crowd).

# --- The gateway running FLOD ---
GATEWAY_HOST="root@192.0.2.1"
GATEWAY_SSH_KEY="$HOME/.ssh/gateway_key"
STAGE1_UNIT="ddos-stage1.service"
STAGE2_UNIT="ddos-stage2.service"
BLOCKLIST_SET="ddos_blocklist"
RATELIMIT_SET="ddos_ratelimit"

# --- Targets under test (protected hosts), comma separated ---
# Used only for documentation in the report; the actual traffic goes wherever
# your generator commands below point it.
TARGET_IPS="192.0.2.10,192.0.2.11,192.0.2.12"

# --- Generator hosts. Two are supported (matching a typical lab with an
# "attacker" box and a "flash crowd" box); leave the _2 variables empty if
# you only have one. ---
NORMAL_HOST="root@198.51.100.10"
NORMAL_SSH_KEY="$HOME/.ssh/normal_key"
NORMAL_HOST_2="root@198.51.100.11"
NORMAL_SSH_KEY_2="$HOME/.ssh/normal_key"

FLASHCROWD_HOST="root@198.51.100.10"
FLASHCROWD_SSH_KEY="$HOME/.ssh/normal_key"
FLASHCROWD_HOST_2="root@198.51.100.11"
FLASHCROWD_SSH_KEY_2="$HOME/.ssh/normal_key"

ATTACK_HOST="root@198.51.100.10"
ATTACK_SSH_KEY="$HOME/.ssh/normal_key"

# --- Normal traffic. Started for Phase 1 and left running through every
# later phase that also wants it (4, 5, 7), stopped only when a phase
# doesn't want it (2, 3, 6). Run time is set long enough to outlast the
# whole session; STOP_CMD ends it early when a phase drops it. ---
NORMAL_START_CMD="cd /root && nohup locust -f locust.py --headless -u 20 -r 4 --run-time 3600s > /root/bench_normal.log 2>&1 & echo \$! > /root/bench_normal.pid"
NORMAL_STOP_CMD="kill \$(cat /root/bench_normal.pid) 2>/dev/null; pkill -9 -f '[l]ocust -f locust.py' 2>/dev/null"
NORMAL_START_CMD_2="cd /root && nohup locust -f locust.py --headless -u 20 -r 4 --run-time 3600s > /root/bench_normal.log 2>&1 & echo \$! > /root/bench_normal.pid"
NORMAL_STOP_CMD_2="kill \$(cat /root/bench_normal.pid) 2>/dev/null; pkill -9 -f '[l]ocust -f locust.py' 2>/dev/null"

# --- Flash Crowd traffic. Same reuse-across-phases pattern as Normal above. ---
FLASHCROWD_START_CMD="cd /root && nohup /usr/local/bin/high_traffic even /root/targets.txt /root/source.txt 3600 > /root/bench_crowd.log 2>&1 & echo \$! > /root/bench_crowd.pid"
FLASHCROWD_STOP_CMD="kill \$(cat /root/bench_crowd.pid) 2>/dev/null; pkill -9 -f '[h]igh_traffic' 2>/dev/null"
FLASHCROWD_START_CMD_2="cd /root && nohup /usr/local/bin/high_traffic even /root/targets.txt /root/source.txt 3600 > /root/bench_crowd.log 2>&1 & echo \$! > /root/bench_crowd.pid"
FLASHCROWD_STOP_CMD_2="kill \$(cat /root/bench_crowd.pid) 2>/dev/null; pkill -9 -f '[h]igh_traffic' 2>/dev/null"

# --- Attack traffic. Same reuse-across-phases pattern, single generator host. ---
ATTACK_START_CMD="cd /root && nohup ./attack_mp_jittered /root/targets.txt /root/source.txt 3600 > /root/bench_attack.log 2>&1 & echo \$! > /root/bench_attack.pid"
ATTACK_STOP_CMD="kill \$(cat /root/bench_attack.pid) 2>/dev/null; pkill -9 -f '[h]ping3' 2>/dev/null; pkill -9 -f '[a]ttack_mp_jittered' 2>/dev/null"

# --- Timing (seconds). Defaults shown; override if you need longer/shorter
# observation windows. Seven phases: Normal, Flash Crowd, Attacker, then
# every pairwise mix, then all three together. ---
WARMUP_TIMEOUT_SECS=900
NORMAL_SECS=120
FLASHCROWD_SECS=120
ATTACK_SECS=180
PAIR_SECS=150
ALL_THREE_SECS=180

# --- Capture backends to compare. Each one gets the full seven phase set, in
# the order listed. The script switches Stage 1 between them through
# /etc/ddos_stage1/tuning.env, times each switch, and restores the original
# configuration at the end (also if the script is interrupted). Stage 1
# restarts once per run, so do not run this on a gateway protecting live
# traffic. ---
CAPTURE_MODES="kernel pcap"
# Repeat each backend this many times. Two or more lets the report show how
# much a figure moves between identical runs. Each run takes roughly the
# warm-up plus 20 minutes.
RUNS_PER_MODE=1

# --- Network interfaces on the gateway whose kernel counters the sampler
# reads, so throughput and drops are measured the same way for both
# backends. Leave empty to skip. INGRESS_IFACE is the interface Stage 1
# watches (its --interface value). ---
INGRESS_IFACE="eth0"
EGRESS_IFACE="eth1"

# --- Where Stage 1 keeps its baseline file. Each run uses its own file in
# this directory, so the production baseline is left alone, and the run's
# files are deleted at rollback. ---
BASELINE_DIR="/var/lib/ddos_stage1"

# --- Traffic variants. Each class (NORMAL, FLASHCROWD, ATTACK) can list named
# variants, for example two Normal request patterns or several attack types.
# A variant "bursty" of NORMAL takes NORMAL_V_bursty_START_CMD and
# NORMAL_V_bursty_STOP_CMD (the plain NORMAL_STOP_CMD is used when it is
# missing), the _2 forms for a second host, and NORMAL_V_bursty_DESC for the
# report. Names use lowercase letters, digits and underscores. A class with no
# list runs its plain START_CMD as one variant.
#
# Each time a class starts, the next variant in its list is used, offset by the
# run number, so the phases and the runs do not all look alike. Both backends
# see the same sequence for the same run number. After the seven phases, every
# ATTACK variant also runs alone and then with Normal traffic for
# ATTACK_SWEEP_SECS each, so every attack type is measured on every run. Set
# ATTACK_SWEEP_SECS to 0 to skip the sweep.
#
# NORMAL_VARIANTS="baseline bursty"
# NORMAL_V_baseline_START_CMD="...locust -f locust.py ..."
# NORMAL_V_baseline_DESC="Smooth browsing"
# NORMAL_V_bursty_START_CMD="...locust -f locust_bursty.py ..."
# NORMAL_V_bursty_DESC="Bursty polling"
# FLASHCROWD_VARIANTS="even hot"
# ATTACK_VARIANTS="mixed shapeb syn_flood single_source"
ATTACK_SWEEP_SECS=0
TYPE_GAP_SECS=30

# --- The attack's spread of source addresses decides how much entropy
# separates it from Normal and Flash Crowd traffic. When ATTACK_SOURCE_FILE is
# set, the run counts the addresses in that file on the attack host and stops
# if the count is outside this range, and it records the count. Leave the file
# empty to skip the check. ---
ATTACK_SOURCE_FILE=""
ATTACK_SOURCES_MIN=30
ATTACK_SOURCES_MAX=40
NORMAL_SOURCE_FILE=""
FLASHCROWD_SOURCE_FILE=""

# Before anything runs, every generator is stopped and the ingress interface
# must stay under this many packets a second (INGRESS_IFACE must be set). It
# catches a generator left running by an interrupted session.
IDLE_INGRESS_MAX_PPS=300

# --- Calibration during each run's warm-up stage. scripts/calibrate.py runs on
# the gateway under the run's Normal traffic once the sensor has warmed up,
# before any measured phase, and the derived floors are recorded. "apply" adds
# them to the sensor's tuning line and restarts it (the run then waits for the
# baseline again). "measure" only records what calibration would derive and
# leaves the floors already in force. "off" skips it. Each backend calibrates
# on its own, so with "apply" the two backends can end up with different floors,
# which the report flags. ---
CALIBRATE="off"
CALIBRATE_WINDOWS=1000
CALIBRATE_TIMEOUT_MINS=30

# --- Where logs and the report land, relative to the repo root. ---
OUTPUT_DIR="./benchmark-live-results"

# --- How often (seconds) the system-health sampler polls CPU time and
# memory for both services on the gateway, for the whole session. ---
SYSTEM_SAMPLE_INTERVAL_SECS=5
